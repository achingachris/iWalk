# Copy to .env (git-ignored) on the VPS and fill in both values.

# A domain whose A record points at the VPS, or the free sslip.io name for its IP,
# for example 203.0.113.10.sslip.io
IWALK_DOMAIN=<vps-ip>.sslip.io

# Shared key the iOS app sends in the X-iWalk-Key header.
# Generate with: openssl rand -hex 32
IWALK_KEY=change-me
